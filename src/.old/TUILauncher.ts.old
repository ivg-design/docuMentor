// TUI Launcher - Spawns and manages the Go TUI process
import { spawn, ChildProcess } from 'child_process'
import { join, dirname } from 'path'
import { existsSync } from 'fs'
import { formatTimeOnly, getCurrentTimestamp } from '../utils/datetime'

export interface TUIMessage {
  type: string;
  [key: string]: any;
}

export class TUILauncher {
  private tuiProcess: ChildProcess | null = null
  private isRunning: boolean = false
  private messageQueue: TUIMessage[] = []

  constructor() {}

  // Start the TUI process
  async start(): Promise<boolean> {
    if (this.isRunning) {
      return true
    }

    // Find the TUI binary
    const tuiPaths = [
      join(process.cwd(), 'src', 'tui', 'documentor-tui'),
      join(__dirname, '..', '..', 'src', 'tui', 'documentor-tui'),
      join(__dirname, '..', 'tui', 'documentor-tui'),
      '/usr/local/bin/documentor-tui',
      join(process.env.HOME || '', '.documentor', 'bin', 'documentor-tui')
    ]

    let tuiBinaryPath: string | null = null
    for (const path of tuiPaths) {
      if (existsSync(path)) {
        tuiBinaryPath = path
        break
      }
    }

    if (!tuiBinaryPath) {
      console.error('TUI binary not found. Falling back to basic logger.')
      console.error('Build the TUI with: cd src/tui && go build -o documentor-tui main.go updateInfoBox.go')
      return false
    }

    try {
      // Spawn the TUI process with proper TTY handling
      // The TUI needs direct access to stdin/stdout/stderr for terminal control
      this.tuiProcess = spawn(tuiBinaryPath, [], {
        stdio: ['pipe', 'inherit', 'inherit'],  // pipe stdin for messages, inherit stdout/stderr for TUI
        env: { ...process.env, TERM: process.env.TERM || 'xterm-256color' },
        shell: false
      })

      this.isRunning = true

      // Handle TUI exit
      this.tuiProcess.on('exit', (code) => {
        this.isRunning = false
        if (code !== 0) {
          console.error(`TUI exited with code ${code}`)
        }
      })

      this.tuiProcess.on('error', (err) => {
        console.error('Failed to start TUI:', err)
        this.isRunning = false
      })

      // Send any queued messages
      while (this.messageQueue.length > 0) {
        const msg = this.messageQueue.shift()
        if (msg) {
          this.send(msg)
        }
      }

      return true
    } catch (error) {
      console.error('Failed to launch TUI:', error)
      return false
    }
  }

  // Send a message to the TUI
  send(message: TUIMessage): void {
    if (!this.isRunning || !this.tuiProcess || !this.tuiProcess.stdin) {
      // Queue the message if TUI isn't ready
      this.messageQueue.push(message)
      return
    }

    try {
      // Send JSON message to TUI's stdin
      this.tuiProcess.stdin.write(JSON.stringify(message) + '\n')
    } catch (error) {
      console.error('Failed to send message to TUI:', error)
    }
  }

  // Log message
  log(level: 'info' | 'warning' | 'error' | 'success', content: string): void {
    this.send({
      type: 'log',
      level,
      content,
      timestamp: formatTimeOnly()
    })
  }

  // Update phase
  updatePhase(current: number, total: number, name: string, subPhase?: string): void {
    this.send({
      type: 'phase',
      phase: {
        current,
        total,
        name,
        subPhase
      }
    })
  }

  // Update file progress
  updateFiles(processed: number, total: number, current?: string): void {
    this.send({
      type: 'file',
      files: {
        processed,
        total,
        current
      }
    })
  }

  // Set project path
  setProject(projectPath: string): void {
    this.send({
      type: 'project',
      projectPath
    })
  }

  // Update lock info
  updateLockInfo(status: string, pid: number, timestamp: string): void {
    this.send({
      type: 'lockInfo',
      lockInfo: {
        status,
        pid,
        timestamp,
        createdAt: timestamp,
        updatedAt: getCurrentTimestamp()
      }
    })
  }

  // Stop the TUI
  stop(): void {
    if (this.tuiProcess) {
      this.tuiProcess.kill('SIGTERM')
      this.tuiProcess = null
      this.isRunning = false
    }
  }

  // Check if TUI is running
  isActive(): boolean {
    return this.isRunning
  }
}

// Singleton instance
let tuiInstance: TUILauncher | null = null

export function getTUILauncher(): TUILauncher {
  if (!tuiInstance) {
    tuiInstance = new TUILauncher()
  }
  return tuiInstance
}

export default TUILauncher