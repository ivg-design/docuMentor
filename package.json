{
  "name": "documentor",
  "version": "3.1.0",
  "description": "DocuMentor v3.1 - Intelligent Documentation Generator with 9-phase AI-powered analysis, Obsidian integration, security validation, and GitHub monitoring",
  "main": "dist/index.js",
  "bin": {
    "documentor": "./dist/index.js",
    "doc": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:binary": "npm run build && npm run pkg",
    "pkg": "pkg dist/index.js --targets node18-linux-x64,node18-macos-x64,node18-win-x64 --output bin/documentor",
    "pkg:linux": "pkg dist/index.js --targets node18-linux-x64 --output bin/documentor-linux",
    "pkg:macos": "pkg dist/index.js --targets node18-macos-x64 --output bin/documentor-macos",
    "pkg:win": "pkg dist/index.js --targets node18-win-x64 --output bin/documentor-win.exe",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist/ bin/",
    "prepare": "npm run build",
    "test": "echo \"No tests yet\"",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix"
  },
  "keywords": [
    "documentation",
    "generator",
    "obsidian",
    "markdown",
    "code-analysis",
    "claude",
    "ai",
    "typescript",
    "javascript",
    "python",
    "go",
    "rust",
    "java"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^8.57.0",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "src/tui/**/*",
      "templates/**/*",
      ".documentor/config.default.json"
    ],
    "outputPath": "bin",
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ]
  }
}
